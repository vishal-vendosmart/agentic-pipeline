# Agentic Pipeline - Environment Variables
# Copy this file to .env and fill in your actual values

# Linear (Task Management)
LINEAR_API_KEY=lin_api_xxx
LINEAR_TEAM_ID=MAR
LINEAR_WEBHOOK_SECRET=whsec_xxx

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-password

# DataForSEO (Keyword Research)
DATAFORSEO_EMAIL=your-api-email@example.com
DATAFORSEO_PASSWORD=your-api-password

# SerpAPI (SERP Analysis)
SERPAPI_KEY=your-api-key

# Zernio (Social Media)
ZERNIO_API_KEY=sk_xxx
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Gamma.app (Infographics)
GAMMA_API_KEY=xxx
GAMMA_BASE_URL=https://public-api.gamma.app/v1

# OpenDesign (Design Generation)
OPENDESIGN_URL=http://localhost:3000

# Payload CMS (Content Management)
PAYLOAD_URL=http://localhost:3001
PAYLOAD_EMAIL=admin@payload.com
PAYLOAD_PASSWORD=your-secure-password

# Coolify (Deployment)
COOLIFY_URL=http://localhost:8000
COOLIFY_WEBHOOK_URL=http://localhost:8000/api/webhooks/deploy/project-id/env-id

# OpenClaw
OPENCLAW_WORKSPACE=/root/.openclaw
